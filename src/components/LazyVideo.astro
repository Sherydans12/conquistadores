---
import { Image } from 'astro:assets';
import { home } from '../data/home';

const { video } = home;
---

<div class="video-card" data-lazy-video data-video-id={video.youtubeId}>
  <div class="video-card__media">
    <Image
      src={video.thumbnail}
      alt={video.alt}
      widths={[640, 960]}
      sizes="(min-width: 56rem) 42rem, 100vw"
      quality={84}
      loading="lazy"
    />
    <button class="video-card__play" type="button">
      Reproducir video
    </button>
  </div>
  <div class="video-card__body">
    <h3>{video.title}</h3>
    <p>{video.description}</p>
    <a
      class="text-link"
      href={video.externalUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Ver directamente en YouTube (sitio externo)
    </a>
  </div>
</div>

<script>
  const lazyVideos = document.querySelectorAll<HTMLElement>('[data-lazy-video]');

  lazyVideos.forEach((videoCard) => {
    const button = videoCard.querySelector<HTMLButtonElement>('.video-card__play');
    const media = videoCard.querySelector<HTMLElement>('.video-card__media');
    const videoId = videoCard.dataset.videoId;

    button?.addEventListener('click', () => {
      if (!media || !videoId) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = 'Video: Un mundo de diferencias';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      media.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>

<style>
  .video-card {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .video-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-primary-deep);
  }

  .video-card__media :global(img),
  .video-card__media :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video-card__media::after {
    position: absolute;
    inset: 0;
    background: rgb(17 27 91 / 0.34);
    content: "";
    pointer-events: none;
  }

  .video-card__play {
    position: relative;
    z-index: 1;
    min-height: 3rem;
    padding: 0.85rem 1.2rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-primary-deep);
    cursor: pointer;
    font-weight: 900;
  }

  .video-card__play:hover {
    background: var(--color-accent-strong);
  }

  .video-card__body {
    padding: var(--space-5);
  }

  h3 {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-xl);
  }

  p {
    color: var(--color-text-muted);
  }
</style>
