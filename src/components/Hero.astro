---
import { Image } from 'astro:assets';
import { home } from '../data/home';
import { site } from '../data/site';

const { hero } = home;
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__image"
    src={hero.image}
    alt={hero.alt}
    widths={[640, 960, 1440, 2200]}
    sizes="100vw"
    quality={84}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <div class="hero__main">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero__tagline">{hero.tagline}</p>
      <div class="hero__actions">
        <a
          class="button button--primary"
          href={hero.primaryCta.href}
          target={hero.primaryCta.external ? '_blank' : undefined}
          rel={hero.primaryCta.external ? 'noopener noreferrer' : undefined}
        >
          {hero.primaryCta.label}
          {hero.primaryCta.external && (
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          )}
        </a>
        <a class="button button--secondary" href={hero.secondaryCta.href}>
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
    <aside class="hero__rail" aria-label="Información del colegio">
      <div>
        <span>Ubicación</span>
        <strong>{site.address.display}</strong>
      </div>
      <div>
        <span>Propuesta educativa</span>
        <strong>Integral e inclusiva</strong>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(36rem, 70svh, 46rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--color-primary-deep);
  }

  .hero__image,
  .hero__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    object-fit: cover;
    object-position: 51% center;
  }

  .hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(20 35 79 / 0.9), rgb(20 35 79 / 0.46) 68%, rgb(20 35 79 / 0.28)),
      linear-gradient(0deg, rgb(20 35 79 / 0.38), transparent 50%);
  }

  .hero__content {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(7rem, 16vh, 11rem) clamp(3.5rem, 9vh, 6rem);
    color: var(--color-surface);
  }

  .hero__eyebrow {
    margin-block-end: var(--space-3);
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 10ch;
    margin-block-end: var(--space-2);
    color: var(--color-surface);
    font-size: var(--font-size-hero);
    letter-spacing: -0.035em;
    line-height: var(--line-height-tight);
  }

  .hero__tagline {
    margin-block-end: var(--space-2);
    color: var(--color-accent);
    font-size: var(--font-size-xl);
    font-weight: 800;
  }

  .hero__rail {
    display: grid;
    max-width: 28rem;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid rgb(255 254 250 / 0.42);
  }

  .hero__rail div {
    display: grid;
    gap: var(--space-1);
  }

  .hero__rail span {
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__rail strong {
    color: var(--color-surface);
    font-size: var(--font-size-sm);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 30rem) {
    .hero {
      min-height: 38rem;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (max-width: 22rem) {
    h1 {
      max-width: none;
      font-size: 2.1rem;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      align-items: center;
      min-height: clamp(36rem, 70svh, 46rem);
    }

    .hero__content {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.35fr);
      align-items: end;
      padding-block: 7rem;
    }

    .hero__rail {
      justify-self: end;
    }
  }
</style>
