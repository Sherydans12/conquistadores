---
import { Image } from 'astro:assets';
import type { Activity } from '../data/home';

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
---

<article class="activity-card">
  <a
    class="activity-card__image-link"
    href={activity.href}
    aria-label={`Leer ${activity.title}`}
  >
    <Image
      src={activity.image}
      alt={activity.alt}
      widths={[480, 720, 960]}
      sizes="(min-width: 64rem) 25rem, (min-width: 42rem) 48vw, 100vw"
      quality={82}
      loading="lazy"
    />
  </a>
  <div class="activity-card__body">
    <div class="activity-card__meta">
      <span>{activity.category}</span>
      <time datetime={activity.date}>{activity.dateLabel}</time>
    </div>
    <h3>
      <a href={activity.href}>
        {activity.title}
      </a>
    </h3>
    <a class="activity-card__link" href={activity.href}>
      Ver actividad <span class="activity-card__link-mark" aria-hidden="true"></span>
    </a>
  </div>
</article>

<style>
  .activity-card {
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color var(--transition-base),
      transform var(--transition-base);
  }

  .activity-card:hover {
    border-color: var(--color-primary-alt);
    transform: translateY(-3px);
  }

  .activity-card__image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-primary-deep);
  }

  .activity-card__image-link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .activity-card:hover .activity-card__image-link :global(img) {
    transform: scale(1.025);
  }

  .activity-card__body {
    padding: var(--space-5);
  }

  .activity-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-end: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .activity-card__meta span {
    padding-block-end: 0.15rem;
    border-block-end: 2px solid var(--color-accent);
    color: var(--color-primary-deep);
    font-weight: 900;
  }

  h3 {
    margin-block-end: var(--space-4);
    font-size: var(--font-size-lg);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .activity-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: 900;
  }

  .activity-card__link-mark {
    position: relative;
    display: inline-block;
    width: 1.15rem;
    height: 0.7rem;
  }

  .activity-card__link-mark::before {
    position: absolute;
    inset-block-start: 50%;
    inset-inline: 0.05rem 0.28rem;
    height: 2px;
    background: currentColor;
    content: "";
    transform: translateY(-50%);
  }

  .activity-card__link-mark::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0.05rem;
    width: 0.45rem;
    height: 0.45rem;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    content: "";
    transform: translateY(-50%) rotate(45deg);
  }
</style>
