---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a class="enrollment-card" href={href}>
  <span class="enrollment-card__mark" aria-hidden="true"></span>
  <span class="enrollment-card__copy">
    <strong>{title}</strong>
    <span>{description}</span>
  </span>
</a>

<style>
  .enrollment-card {
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    border-block-start: 0.25rem solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .enrollment-card:hover {
    border-color: var(--color-primary-alt);
    transform: translateY(-2px);
  }

  .enrollment-card__mark {
    position: relative;
    width: 2.35rem;
    height: 1.2rem;
    flex: 0 0 auto;
    margin-block-start: 0.4rem;
    border-block-start: 2px solid var(--color-accent);
    color: transparent;
  }

  .enrollment-card__mark::after {
    position: absolute;
    inset-block-start: -0.36rem;
    inset-inline-end: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-block-start: 2px solid var(--color-accent);
    border-inline-end: 2px solid var(--color-accent);
    content: '';
    transform: rotate(45deg);
  }

  .enrollment-card__copy,
  .enrollment-card__copy strong,
  .enrollment-card__copy > span {
    display: block;
  }

  .enrollment-card__copy strong {
    margin-block-end: var(--space-2);
    color: var(--color-primary-deep);
  }

  .enrollment-card__copy > span {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }
</style>
