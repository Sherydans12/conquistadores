---
import {
  documentCategoryLabels,
  type PublicDocument,
} from '../../data/documents';
import DocumentStatusBadge from './DocumentStatusBadge.astro';

interface Props {
  document: PublicDocument;
  preview?: boolean;
}

const { document, preview = false } = Astro.props;
const searchText = [
  document.title,
  document.description,
  documentCategoryLabels[document.category],
  document.year,
  ...(document.audience ?? []),
  ...(document.keywords ?? []),
]
  .filter(Boolean)
  .join(' ');
---

<article
  class:list={['document-card', preview && 'document-card--preview']}
  data-document={preview ? undefined : ''}
  data-search={preview ? undefined : searchText}
  data-category={preview ? undefined : document.category}
  data-year={preview ? undefined : document.year?.toString() ?? ''}
  data-status={preview ? undefined : document.status}
>
  <div class="document-card__topline">
    <span class="document-card__category">
      {documentCategoryLabels[document.category]}
    </span>
    {
      document.status !== 'review' && (
        <DocumentStatusBadge status={document.status} />
      )
    }
  </div>

  <h3>{document.title}</h3>
  <p class="document-card__description">{document.description}</p>

  <dl class="document-card__metadata">
    {
      document.year && (
        <div>
          <dt>Año</dt>
          <dd>{document.year}</dd>
        </div>
      )
    }
    {
      document.fileType && (
        <div>
          <dt>Formato</dt>
          <dd>{document.fileType}</dd>
        </div>
      )
    }
    {
      document.fileSize && (
        <div>
          <dt>Tamaño</dt>
          <dd>{document.fileSize}</dd>
        </div>
      )
    }
    {
      document.updatedAt && (
        <div>
          <dt>Actualización</dt>
          <dd>{document.updatedAt}</dd>
        </div>
      )
    }
  </dl>

  {
    document.audience && document.audience.length > 0 && (
      <p class="document-card__audience">
        <strong>Dirigido a:</strong> {document.audience.join(', ')}
      </p>
    )
  }

  <a
    class="document-card__action"
    href={document.href}
    target={document.external ? '_blank' : undefined}
    rel={document.external ? 'noopener noreferrer' : undefined}
  >
    Ver documento
    {
      document.external && (
        <span class="sr-only"> (se abre fuera de este sitio)</span>
      )
    }
  </a>

  {
    document.external && (
      <p class="document-card__external">Enlace externo temporal</p>
    )
  }
</article>

<style>
  .document-card {
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    padding: clamp(1.15rem, 2.5vw, 1.6rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .document-card--preview {
    border-block-start: 0.35rem solid var(--color-accent);
  }

  .document-card__topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
  }

  .document-card__category {
    color: var(--color-primary-alt);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.055em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  h3 {
    margin-block-end: var(--space-3);
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.3rem);
  }

  .document-card__description {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .document-card__metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    margin: auto 0 var(--space-3);
    border-block: 1px solid var(--color-border);
  }

  .document-card__metadata div {
    display: flex;
    gap: var(--space-1);
  }

  .document-card__metadata dt,
  .document-card__metadata dd {
    margin: 0;
    font-size: var(--font-size-xs);
  }

  .document-card__metadata dt {
    color: var(--color-text-muted);
  }

  .document-card__metadata dd {
    color: var(--color-primary-deep);
    font-weight: 800;
  }

  .document-card__audience {
    margin-block-end: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .document-card__action {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    align-self: flex-start;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: 900;
    text-decoration: none;
  }

  .document-card__action:hover {
    background: var(--color-primary);
    color: var(--color-surface);
  }

  .document-card__external {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }
</style>
