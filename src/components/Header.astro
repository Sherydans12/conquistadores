---
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/colegio-conquistadores-logo.png';
import { enrollmentCta, primaryNavigation } from '../data/navigation';
import MobileNav from './MobileNav.astro';

const currentPath = Astro.url.pathname;

function isCurrent(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href === '/actividades/' && /^\/\d{4}\/\d{2}\/\d{2}\//.test(currentPath)) {
    return true;
  }
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Colegio Conquistadores, inicio">
      <Image
        src={logo}
        alt="Escudo del Colegio Conquistadores"
        width={72}
        height={78}
        quality={90}
      />
      <span class="brand__text">
        <strong>Colegio</strong>
        <span>Conquistadores</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul>
        {
          primaryNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="header-cta"
      href={enrollmentCta.href}
      aria-current={isCurrent(enrollmentCta.href) ? 'page' : undefined}
    >
      {enrollmentCta.label}
    </a>
    <MobileNav />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: var(--layer-header);
    inset-block-start: 0;
    min-height: var(--header-height-mobile);
    background: var(--color-primary);
    color: var(--color-surface);
    box-shadow: 0 0.4rem 1.3rem rgb(17 27 91 / 0.2);
  }

  .site-header__inner {
    min-height: var(--header-height-mobile);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-2);
    margin-inline-end: auto;
    color: var(--color-surface);
    text-decoration: none;
  }

  .brand :global(img) {
    width: 3.15rem;
    height: 3.45rem;
    object-fit: contain;
  }

  .brand__text {
    display: none;
    line-height: 1.05;
  }

  .brand__text strong,
  .brand__text span {
    display: block;
  }

  .brand__text strong {
    font-size: var(--font-size-sm);
  }

  .brand__text span {
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .desktop-nav {
    display: none;
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-primary-deep);
    font-size: clamp(0.7rem, 0.65rem + 0.25vw, 0.84rem);
    font-weight: 900;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
  }

  .header-cta:hover {
    background: var(--color-accent-strong);
  }

  @media (min-width: 32rem) {
    .brand__text {
      display: block;
    }
  }

  @media (min-width: 70rem) {
    .site-header {
      min-height: var(--header-height-desktop);
    }

    .site-header__inner {
      min-height: var(--header-height-desktop);
      gap: var(--space-5);
    }

    .brand {
      margin-inline-end: 0;
    }

    .brand :global(img) {
      width: 3.8rem;
      height: 4.15rem;
    }

    .desktop-nav {
      display: block;
      margin-inline-start: auto;
    }

    .desktop-nav > ul {
      display: flex;
      align-items: center;
      gap: clamp(0.25rem, 0.8vw, 0.75rem);
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .desktop-nav a {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      padding: 0.65rem 0.48rem;
      border-block-end: 2px solid transparent;
      color: var(--color-surface);
      cursor: pointer;
      font-size: clamp(0.68rem, 0.58rem + 0.35vw, 0.82rem);
      font-weight: 800;
      text-decoration: none;
      white-space: nowrap;
    }

    .desktop-nav a:hover,
    .desktop-nav a[aria-current="page"] {
      border-block-end-color: var(--color-accent);
      color: var(--color-accent);
    }

    .header-cta {
      flex: 0 0 auto;
      padding-inline: 1rem;
    }
  }

  @media (min-width: 80rem) {
    .brand__text {
      display: block;
    }
  }
</style>
