---
import { familyPortal } from '../data/family-portal';

interface Props {
  id?: string;
}

const { id = 'portal-familias' } = Astro.props;
---

<section class="family-portal" id={id} aria-labelledby={`${id}-title`}>
  <div class="container family-portal__layout">
    <div class="family-portal__intro">
      <h2 id={`${id}-title`}>{familyPortal.title}</h2>
      <p>{familyPortal.description}</p>
      <a
        class="button button--primary family-portal__cta"
        href={familyPortal.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {familyPortal.ctaLabel}
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
        <span class="sr-only">(se abre en una pestaña nueva)</span>
      </a>
      <p class="family-portal__note">El portal se abre en una pestaña nueva.</p>
    </div>

    <ul class="family-portal__services" aria-label="Servicios disponibles en el portal">
      {
        familyPortal.services.map((service) => (
          <li>
            <span class="family-portal__icon" aria-hidden="true">
              {service.icon === 'payment' && (
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="M3 9h18M7 15h4"></path>
                </svg>
              )}
              {service.icon === 'student-certificate' && (
                <svg viewBox="0 0 24 24">
                  <path d="M7 3h7l4 4v14H7zM14 3v5h5"></path>
                  <path d="M10 13h5M10 17h5"></path>
                </svg>
              )}
              {service.icon === 'debt-certificate' && (
                <svg viewBox="0 0 24 24">
                  <path d="M7 3h7l4 4v14H7zM14 3v5h5"></path>
                  <path d="m10 15 2 2 4-5"></path>
                </svg>
              )}
            </span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .family-portal {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
    background: var(--color-primary-deep);
    color: rgb(255 255 255 / 0.84);
  }

  .family-portal__layout {
    display: grid;
    gap: var(--space-7);
  }

  .family-portal__intro {
    max-width: 39rem;
  }

  .family-portal h2 {
    max-width: 18ch;
    margin-block-end: var(--space-4);
    color: var(--color-surface);
    font-size: var(--font-size-2xl);
    letter-spacing: -0.025em;
  }

  .family-portal__intro > p:first-of-type {
    max-width: 65ch;
    margin-block-end: var(--space-5);
    color: rgb(255 255 255 / 0.8);
    font-size: var(--font-size-lg);
  }

  .family-portal__cta svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .family-portal__note {
    margin: var(--space-3) 0 0;
    color: rgb(255 255 255 / 0.68);
    font-size: var(--font-size-xs);
  }

  .family-portal__services {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .family-portal__services li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block-end: 1px solid rgb(255 255 255 / 0.18);
  }

  .family-portal__services li:first-child {
    padding-block-start: 0;
  }

  .family-portal__services li:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .family-portal__icon {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(232 185 77 / 0.5);
    border-radius: var(--radius-md);
    color: var(--color-accent);
  }

  .family-portal__icon svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .family-portal__services h3 {
    margin-block-end: var(--space-2);
    color: var(--color-surface);
    font-size: var(--font-size-lg);
  }

  .family-portal__services p {
    max-width: 48ch;
    margin: 0;
    color: rgb(255 255 255 / 0.72);
  }

  @media (min-width: 50rem) {
    .family-portal__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
      align-items: center;
      gap: clamp(3rem, 8vw, 7rem);
    }
  }

  @media (max-width: 30rem) {
    .family-portal__cta {
      width: 100%;
    }
  }
</style>
