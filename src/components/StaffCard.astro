---
import { Image } from 'astro:assets';
import type { StaffMember } from '../data/staff';

interface Props {
  member: StaffMember;
}

const { member } = Astro.props;
const initials = member.name
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join('');
---

<article class="staff-card">
  <div class="staff-card__portrait">
    {
      member.image ? (
        <Image
          src={member.image}
          alt={member.imageAlt ?? `Retrato de ${member.name}`}
          widths={[150, 300]}
          sizes="9rem"
          quality={84}
          loading="lazy"
        />
      ) : (
        <span aria-hidden="true">{initials}</span>
      )
    }
  </div>
  <div class="staff-card__body">
    <h3>{member.name}</h3>
    <p>{member.role}</p>
  </div>
</article>

<style>
  .staff-card {
    min-width: 0;
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .staff-card__portrait {
    width: min(8.5rem, 100%);
    aspect-ratio: 1;
    display: grid;
    overflow: hidden;
    place-items: center;
    margin: 0 auto var(--space-4);
    border: 0.3rem solid #eef0f8;
    border-radius: 50%;
    background: var(--color-primary-alt);
    color: var(--color-surface);
    font-size: var(--font-size-xl);
    font-weight: 900;
  }

  .staff-card__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .staff-card h3 {
    margin-block-end: var(--space-2);
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .staff-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  @media (min-width: 42rem) {
    .staff-card {
      padding: var(--space-5);
    }
  }
</style>
