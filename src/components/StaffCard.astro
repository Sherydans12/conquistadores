---
import { Image } from 'astro:assets';
import type { StaffMember } from '../data/staff';

interface Props {
  member: StaffMember;
}

const { member } = Astro.props;
---

<article class="staff-card">
  {
    member.image ? (
      <div class="staff-card__portrait">
        <Image
          src={member.image}
          alt={member.imageAlt ?? `Retrato de ${member.name}`}
          widths={[160, 256]}
          sizes="5.5rem"
          quality={84}
          loading="lazy"
        />
      </div>
    ) : (
      <div class="staff-card__portrait staff-card__portrait--pending">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <circle cx="16" cy="11" r="5" />
          <path d="M6.5 27c.8-5.1 4.3-8 9.5-8s8.7 2.9 9.5 8" />
        </svg>
        <span>Foto pendiente</span>
      </div>
    )
  }
  <div class="staff-card__body">
    <h3>{member.name}</h3>
    <p>{member.role}</p>
  </div>
</article>

<style>
  .staff-card {
    min-width: 0;
    min-height: 7.25rem;
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .staff-card__portrait {
    width: 5.25rem;
    aspect-ratio: 1;
    display: grid;
    overflow: hidden;
    place-items: center;
    border-radius: 0.75rem;
    background: var(--color-surface-soft);
  }

  .staff-card__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .staff-card__portrait--pending {
    align-content: center;
    gap: 0.35rem;
    padding: 0.4rem;
    border: 1px dashed #9aa5b9;
    background: #f4f5f7;
    color: #59657b;
    text-align: center;
  }

  .staff-card__portrait--pending svg {
    width: 1.7rem;
    height: 1.7rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .staff-card__portrait--pending span {
    font-size: 0.58rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .staff-card__body {
    min-width: 0;
  }

  .staff-card h3 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1rem, 0.94rem + 0.18vw, 1.12rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .staff-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.48;
    overflow-wrap: anywhere;
  }

  @media (max-width: 24rem) {
    .staff-card {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .staff-card__portrait {
      width: 4.5rem;
    }
  }
</style>
