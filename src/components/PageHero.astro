---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs, { type BreadcrumbItem } from './Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  breadcrumbs: BreadcrumbItem[];
}

const {
  title,
  description,
  eyebrow,
  heroImage,
  heroAlt = '',
  breadcrumbs,
} = Astro.props;
---

<header class:list={['page-hero', { 'page-hero--image': heroImage }]}>
  {
    heroImage && (
      <Image
        class="page-hero__image"
        src={heroImage}
        alt={heroAlt}
        widths={[720, 1080, 1440, 1920]}
        sizes="100vw"
        quality={84}
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="page-hero__overlay" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <Breadcrumbs items={breadcrumbs} />
    <div class="page-hero__copy">
      {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="page-hero__description">{description}</p>
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(22rem, 48vw, 32rem);
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary-deep), var(--color-primary-alt));
    color: var(--color-surface);
  }

  .page-hero__image,
  .page-hero__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero__image {
    object-fit: cover;
  }

  .page-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(17 27 91 / 0.96), rgb(17 27 91 / 0.64)),
      linear-gradient(0deg, rgb(17 27 91 / 0.35), transparent);
  }

  .page-hero:not(.page-hero--image) .page-hero__overlay {
    background:
      radial-gradient(circle at 85% 10%, rgb(232 185 77 / 0.2), transparent 28%),
      linear-gradient(135deg, var(--color-primary-deep), var(--color-primary-alt));
  }

  .page-hero__inner {
    min-height: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    padding-block: var(--space-5) clamp(4rem, 10vw, 7rem);
  }

  .page-hero__copy {
    max-width: 48rem;
  }

  .page-hero__eyebrow {
    margin-block-end: var(--space-3);
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-hero h1 {
    margin-block-end: var(--space-4);
    color: var(--color-surface);
    font-size: clamp(2.4rem, 1.8rem + 3vw, 4.8rem);
    text-wrap: balance;
  }

  .page-hero__description {
    max-width: 44rem;
    margin: 0;
    color: rgb(255 255 255 / 0.86);
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  @media (max-width: 32rem) {
    .page-hero {
      min-height: 25rem;
    }
  }
</style>
