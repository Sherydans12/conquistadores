---
import Callout from '../components/Callout.astro';
import StaffCard from '../components/StaffCard.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { getStaffByArea, staff, staffAreas } from '../data/staff';
---

<PageLayout
  title="Personal"
  description="Conoce a las personas que acompañan el aprendizaje, el bienestar y la vida diaria del Colegio Conquistadores."
  canonicalPath="/personal/"
  breadcrumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Personal' },
  ]}
>
  <section class="page-section page-section--surface staff-overview" aria-labelledby="equipo-title">
    <div class="container">
      <div class="staff-overview__intro">
        <div>
          <h2 id="equipo-title">Personas que acompañan el aprendizaje</h2>
          <p>
            Conoce cómo se organiza el equipo del colegio, desde la dirección y el apoyo
            pedagógico hasta la convivencia, la enseñanza y los servicios cotidianos.
          </p>
        </div>
        <p class="staff-overview__summary">
          <strong>{staff.length}</strong> integrantes
          <span aria-hidden="true">·</span>
          <strong>{staffAreas.length}</strong> áreas
        </p>
      </div>

      <div class="staff-index">
        <div class="staff-index__heading">
          <h3 id="staff-index-title">Explora las áreas</h3>
          <p>Selecciona una para ir directo a su equipo.</p>
        </div>
        <nav id="staff-index" class="staff-jump" aria-labelledby="staff-index-title">
          {
            staffAreas.map((area) => {
              const memberCount = getStaffByArea(area.id).length;

              return (
                <a
                  href={`#${area.id}`}
                  aria-label={`Ir a ${area.label}, ${memberCount} integrantes`}
                >
                  <span class="staff-jump__label">{area.shortLabel}</span>
                  <span class="staff-jump__count" aria-hidden="true">{memberCount}</span>
                </a>
              );
            })
          }
        </nav>
      </div>

      <p class="staff-note">
        Esta nómina refleja la organización presentada por el colegio. Para confirmar una función
        o contactar a una persona, utiliza los canales oficiales.
      </p>
    </div>
  </section>

  {
    staffAreas.map((area, index) => {
      const members = getStaffByArea(area.id);

      return (
        <section
          class:list={[
            'page-section',
            'staff-section',
            { 'staff-section--alternate': index % 2 === 0 },
          ]}
          id={area.id}
          aria-labelledby={`${area.id}-title`}
        >
          <div class="container">
            <header class="staff-section__heading">
              <div class="staff-section__titlegroup">
                <h2 class="staff-section__title" id={`${area.id}-title`}>{area.label}</h2>
                <p>{area.description}</p>
              </div>
              <a class="staff-section__back" href="#staff-index">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12 19V5m-7 7 7-7 7 7" />
                </svg>
                Volver al índice
              </a>
            </header>
            <div class="staff-grid">
              {members.map((member) => <StaffCard member={member} />)}
            </div>
          </div>
        </section>
      );
    })
  }

  <Callout slot="cta" title="¿Necesitas contactar al equipo?" variant="soft">
    <p>Escríbenos o llámanos a través de los canales oficiales del colegio.</p>
    <div slot="actions">
      <a class="button button--primary" href="/#contacto">Ver contacto</a>
      <a class="button text-link" href="/quienes-somos/">Quiénes somos</a>
    </div>
  </Callout>
</PageLayout>

<style>
  .staff-overview__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-block-end: var(--space-7);
  }

  .staff-overview__intro > div {
    max-width: var(--container-narrow);
  }

  .staff-overview__intro h2 {
    margin-block-end: var(--space-3);
    font-size: var(--font-size-2xl);
  }

  .staff-overview__intro > div > p {
    max-width: 65ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .staff-overview__summary {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 0.15rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  .staff-overview__summary strong {
    color: var(--color-primary);
    font-size: var(--font-size-base);
  }

  .staff-index {
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-border);
  }

  .staff-index__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
  }

  .staff-index__heading h3 {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .staff-index__heading p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .staff-jump {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .staff-jump a {
    min-width: 0;
    min-height: 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-primary-deep);
    font-size: var(--font-size-sm);
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .staff-jump a:hover {
    border-color: var(--color-primary-alt);
    background: #f8f9fb;
    color: var(--color-primary);
  }

  .staff-jump__label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .staff-jump__count {
    min-width: 1.7rem;
    min-height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-surface-soft);
    color: var(--color-primary);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }

  .staff-note {
    max-width: 75ch;
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .staff-section {
    scroll-margin-top: calc(var(--header-height-mobile) + var(--space-5));
  }

  .staff-section--alternate {
    background: var(--color-surface-soft);
  }

  .staff-section__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block-end: var(--space-5);
    margin-block-end: var(--space-5);
    border-block-end: 1px solid var(--color-border);
  }

  .staff-section__titlegroup {
    min-width: 0;
  }

  .staff-section__title {
    margin-block-end: var(--space-3);
    font-size: clamp(1.45rem, 1.22rem + 1.15vw, 2.1rem);
  }

  .staff-section__titlegroup > p {
    max-width: 65ch;
    margin: 0;
    color: var(--color-text-muted);
  }

  .staff-section__back {
    min-height: 2.75rem;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .staff-section__back:hover {
    border-color: var(--color-primary-alt);
    background: var(--color-surface);
  }

  .staff-section__back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .staff-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 42rem) {
    .staff-jump {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .staff-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 70rem) {
    .staff-jump {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .staff-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (max-width: 42rem) {
    .staff-overview__intro {
      align-items: start;
      flex-direction: column;
      gap: var(--space-3);
      margin-block-end: var(--space-6);
    }

    .staff-index__heading {
      align-items: start;
      flex-direction: column;
    }

    .staff-section__heading {
      align-items: start;
      flex-direction: column;
    }

    .staff-section__back {
      width: 100%;
    }
  }

  @media (max-width: 27rem) {
    .staff-jump {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .staff-jump a,
    .staff-section__back {
      transition: none;
    }
  }
</style>
