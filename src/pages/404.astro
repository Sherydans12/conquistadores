---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no está disponible en el sitio del Colegio Conquistadores."
  canonicalPath="/404/"
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <p class="not-found__code" aria-hidden="true">404</p>
      <p class="not-found__eyebrow">Página no encontrada</p>
      <h1 id="not-found-title">No pudimos encontrar lo que buscas</h1>
      <p class="not-found__description">
        Es posible que la dirección haya cambiado o que este contenido todavía no
        esté disponible en el nuevo sitio.
      </p>
      <div class="not-found__actions">
        <a class="button button--primary" href="/">Volver al inicio</a>
        <a class="button not-found__secondary" href="/documentos/">Documentos</a>
        <a class="button not-found__secondary" href="/matriculas-2026/">
          Matrículas 2026
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 64svh;
    display: grid;
    place-items: center;
    padding-block: var(--space-8);
    background:
      radial-gradient(circle at 82% 16%, rgb(232 185 77 / 0.22), transparent 28%),
      var(--color-primary-deep);
    color: var(--color-surface);
  }

  .not-found__inner {
    max-width: 48rem;
    text-align: center;
  }

  .not-found__code {
    margin-block-end: var(--space-2);
    color: rgb(255 255 255 / 0.12);
    font-size: clamp(5rem, 4rem + 8vw, 10rem);
    font-weight: 900;
    line-height: 0.8;
  }

  .not-found__eyebrow {
    margin-block-end: var(--space-3);
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .not-found h1 {
    margin-block-end: var(--space-4);
    color: var(--color-surface);
    font-size: var(--font-size-2xl);
  }

  .not-found__description {
    max-width: 40rem;
    margin: 0 auto var(--space-6);
    color: rgb(255 255 255 / 0.8);
    font-size: var(--font-size-lg);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .not-found__secondary {
    border-color: rgb(255 255 255 / 0.55);
    color: var(--color-surface);
  }
</style>
