---
import { Image } from 'astro:assets';
import documentsIllustration from '../assets/images/editorial/documentos-editorial.webp';
import DocumentCard from '../components/documents/DocumentCard.astro';
import DocumentList from '../components/documents/DocumentList.astro';
import DocumentSearch from '../components/documents/DocumentSearch.astro';
import ExternalServiceCard from '../components/documents/ExternalServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ENROLLMENT_DOCUMENTS_EMPTY_MESSAGE,
  getEnrollmentDocuments2027,
  loadDocumentCatalog,
} from '../lib/cms/documents';

const catalog = await loadDocumentCatalog();
const publicDocuments = catalog.documents;
const getPublicDocumentsByCategory = (category: string) =>
  publicDocuments.filter(
    (document) =>
      document.category === category &&
      document.status !== 'historical' &&
      document.status !== 'external',
  );
const evaluationDocuments = getPublicDocumentsByCategory('evaluaciones');
const readingPlanDocuments = getPublicDocumentsByCategory('plan-lector');
const regulationDocuments = getPublicDocumentsByCategory('reglamentos');
const enrollmentDocuments2027 = getEnrollmentDocuments2027(catalog);
const previousEnrollmentDocuments = publicDocuments.filter(
  (document) =>
    document.category === 'matriculas' && document.year === 2026,
);
const institutionalDocuments = getPublicDocumentsByCategory('institucionales');
const featuredDocuments = publicDocuments.filter((document) => document.featured);
const publicHistoricalDocuments = publicDocuments.filter(
  (document) =>
    document.status === 'historical' &&
    !(document.category === 'matriculas' && document.year === 2026),
);
const publicExternalServices = publicDocuments.filter(
  (document) => document.status === 'external',
);
const years = Array.from(
  new Set(
    publicDocuments
      .map((document) => document.year)
      .filter((year): year is number => typeof year === 'number'),
  ),
).sort((left, right) => right - left);
---

<BaseLayout
  title="Documentos | Colegio Conquistadores"
  description="Consulta documentos públicos del Colegio Conquistadores, incluida la sección de Matrículas y admisión 2027, reglamentos, planes de lectura y archivos de años anteriores."
  canonicalPath="/documentos/"
>
  <header class="documents-hero">
    <div class="container documents-hero__inner">
      <div class="documents-hero__copy">
        <p class="documents-hero__eyebrow">Información pública</p>
        <h1>Documentos</h1>
        <p>
          Encuentra la documentación pública de Matrículas y admisión 2027 junto
          con calendarios, planes, reglamentos y archivos de años anteriores.
        </p>
        <p class="documents-hero__note">{publicDocuments.length} documentos públicos disponibles en el catálogo.</p>
      </div>
      <div class="documents-hero__media" aria-hidden="true">
        <Image
          src={documentsIllustration}
          alt=""
          widths={[640, 960, 1280]}
          sizes="(min-width: 56rem) 46vw, 100vw"
          quality={86}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </header>

  <section class="documents-tools" aria-label="Búsqueda y filtros">
    <div class="container">
      <DocumentSearch
        total={publicDocuments.length}
        categories={catalog.categories}
        years={years}
      />
    </div>
  </section>

  <nav class="document-jump" aria-label="Secciones de documentos">
    <div class="container document-jump__links">
      <a href="#matriculas-admision-2027">Matrículas 2027</a>
      <a href="#evaluaciones-2026">Evaluaciones 2026</a>
      <a href="#plan-lector">Plan lector</a>
      <a href="#reglamentos">Reglamentos</a>
      <a href="#matriculas-admision-anteriores">Años anteriores</a>
      <a href="#archivo-historico">Archivo histórico</a>
    </div>
  </nav>

  <section
    class="section featured-documents"
    aria-labelledby="featured-documents-title"
    data-featured-section
  >
    <div class="container">
      <div class="section-intro">
        <p class="section-intro__eyebrow">Accesos destacados</p>
        <h2 id="featured-documents-title">Documentos destacados</h2>
        <p>
          Accesos directos a los documentos destacados por el colegio.
        </p>
      </div>
      <div class="featured-documents__grid">
        {
          featuredDocuments.map((document) => (
            <DocumentCard document={document} preview />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section documents-catalog" aria-labelledby="catalog-title">
    <div class="container">
      <div class="catalog-heading">
        <p class="section-intro__eyebrow">Centro documental</p>
        <h2 id="catalog-title">Listado de documentos públicos</h2>
      </div>

      <div class="document-groups" data-document-groups>
        <DocumentList
          id="matriculas-admision-2027"
          title="Matrículas y admisión 2027"
          documents={enrollmentDocuments2027}
          emptyMessage={ENROLLMENT_DOCUMENTS_EMPTY_MESSAGE}
        />

        <DocumentList
          id="evaluaciones-2026"
          title="Evaluaciones y calendarios 2026"
          description="Calendarios del primer semestre organizados por curso."
          documents={evaluationDocuments}
        />

        <DocumentList
          id="plan-lector"
          title="Plan lector 2026"
          description="Planes de lecturas complementarias y domiciliarias por nivel."
          documents={readingPlanDocuments}
        />

        <DocumentList
          id="reglamentos"
          title="Reglamentos y convivencia"
          description="Reglamentos y orientaciones para la comunidad educativa."
          documents={regulationDocuments}
        />

        <DocumentList
          id="documentos-institucionales"
          title="Documentos institucionales"
          description="Documentos sobre el proyecto educativo y la organización del colegio."
          documents={institutionalDocuments}
        />

        <DocumentList
          id="matriculas-admision-anteriores"
          title="Matrículas y admisión — años anteriores"
          description="Documentos del proceso de Matrículas 2026, conservados como referencia histórica. No corresponden a los requisitos de 2027."
          documents={previousEnrollmentDocuments}
          archive
        />

        <section
          class="review-notice"
          id="protocolos"
          aria-labelledby="protocolos-title"
          data-review-notice
        >
          <p class="review-notice__eyebrow">Documentos en revisión</p>
          <h2 id="protocolos-title">Protocolos internos</h2>
          <p>
            Los protocolos de años anteriores están en revisión. Por ahora no
            están disponibles como documentos vigentes.
          </p>
        </section>

        <DocumentList
          id="archivo-historico"
          title="Archivo histórico"
          description="Versiones anteriores conservadas como referencia. No corresponden al periodo actual."
          documents={publicHistoricalDocuments}
          archive
        />

        <section
          class="external-services"
          id="servicios-externos"
          aria-labelledby="external-services-title"
          data-document-section
        >
          <div class="external-services__heading">
            <h2 id="external-services-title">Servicios externos</h2>
            <p>
              Accesos oficiales que funcionan fuera del sitio del colegio.
            </p>
          </div>
          {
            publicExternalServices.map((document) => (
              <ExternalServiceCard document={document} />
            ))
          }
        </section>
      </div>

      <div
        class="empty-state"
        role="status"
        aria-live="polite"
        hidden
        data-document-empty
      >
        <p class="empty-state__title">No encontramos coincidencias</p>
        <p>
          Prueba con otra palabra o utiliza “Limpiar filtros” para volver a ver
          todos los documentos.
        </p>
      </div>
    </div>
  </section>

  <section class="documents-help" aria-labelledby="documents-help-title">
    <div class="container documents-help__inner">
      <div>
        <p class="section-intro__eyebrow">¿Necesitas orientación?</p>
        <h2 id="documents-help-title">Consulta antes de usar una versión antigua</h2>
        <p>
          Si un archivo aparece como histórico o no está disponible en esta
          página, confirma su uso con el colegio antes de realizar un trámite.
        </p>
      </div>
      <a class="button button--primary" href="tel:+56512234652">
        Llamar al colegio
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .documents-hero {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 5vw, 4rem);
    background: var(--color-primary-deep);
    color: var(--color-surface);
  }

  .documents-hero__inner {
    display: grid;
    align-items: center;
    gap: var(--space-7);
  }

  .documents-hero__copy {
    max-width: var(--container-narrow);
  }

  .documents-hero__eyebrow,
  .section-intro__eyebrow,
  .review-notice__eyebrow {
    margin-block-end: var(--space-2);
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .documents-hero h1 {
    margin-block-end: var(--space-4);
    color: var(--color-surface);
    font-size: var(--font-size-2xl);
  }

  .documents-hero__copy > p:not(.documents-hero__note) {
    max-width: 44rem;
    margin: 0;
    color: rgb(255 255 255 / 0.82);
    font-size: var(--font-size-lg);
  }

  .documents-hero__note {
    margin-block-start: var(--space-4) !important;
    color: var(--color-accent) !important;
    font-size: var(--font-size-sm) !important;
    font-weight: 900;
  }

  .documents-hero__media {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-lg);
    background: var(--color-primary-deep);
  }

  .documents-hero__media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .documents-tools {
    background: #fff;
  }

  .documents-tools > .container {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .document-jump {
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-border);
    background: #fff;
  }

  .document-jump__links {
    display: flex;
    overflow-x: auto;
    gap: var(--space-2);
    padding-block: var(--space-1);
    scrollbar-width: thin;
  }

  .document-jump a {
    display: inline-flex;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    padding: 0.55rem 0.2rem;
    border-block-end: 2px solid transparent;
    color: var(--color-primary);
    font-size: var(--font-size-xs);
    font-weight: 900;
    text-decoration: none;
  }

  .document-jump a:hover {
    border-block-end-color: var(--color-accent);
    color: var(--color-primary-alt);
  }

  .featured-documents {
    background: var(--color-surface);
  }

  .section-intro,
  .catalog-heading {
    max-width: 48rem;
    margin-block-end: var(--space-6);
  }

  .section-intro h2,
  .catalog-heading h2 {
    margin-block-end: var(--space-3);
    font-size: var(--font-size-2xl);
  }

  .section-intro p:last-child,
  .catalog-heading p:last-child {
    margin: 0;
    color: var(--color-text-muted);
  }

  .featured-documents__grid {
    display: grid;
    gap: var(--space-4);
  }

  .documents-catalog {
    background: var(--color-background);
  }

  .document-groups {
    padding-block: clamp(1.1rem, 3vw, 2.2rem);
  }

  .review-notice {
    scroll-margin-top: calc(var(--header-height-desktop) + var(--space-5));
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-block-start: var(--space-7);
    border: 1px solid var(--color-border);
    border-block-start: 0.25rem solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
  }

  .review-notice__eyebrow {
    color: var(--color-primary-alt);
  }

  .review-notice h2 {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-xl);
  }

  .review-notice p:last-child {
    max-width: 48rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .external-services {
    padding-block-start: var(--space-7);
    margin-block-start: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }

  .external-services__heading {
    max-width: 48rem;
    margin-block-end: var(--space-5);
  }

  .external-services__heading h2 {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-xl);
  }

  .external-services__heading p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .empty-state {
    padding: clamp(2rem, 5vw, 4rem);
    margin-block-start: var(--space-6);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: center;
  }

  .empty-state__title {
    margin-block-end: var(--space-2);
    color: var(--color-primary-deep);
    font-size: var(--font-size-xl);
    font-weight: 900;
  }

  .empty-state p:last-child {
    max-width: 35rem;
    margin: 0 auto;
    color: var(--color-text-muted);
  }

  .documents-help {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--color-accent);
  }

  .documents-help__inner {
    display: grid;
    align-items: center;
    gap: var(--space-5);
  }

  .documents-help h2 {
    margin-block-end: var(--space-3);
    font-size: var(--font-size-2xl);
  }

  .documents-help p:last-child {
    max-width: 50rem;
    margin: 0;
  }

  .documents-help .button {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-surface);
  }

  @media (min-width: 44rem) {
    .featured-documents__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .documents-hero__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
    }

    .documents-help__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
